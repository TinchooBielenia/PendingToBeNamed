      propertyPath: _hintsByID.Array.data[0].text
      value: Find out what is going on...
      objectReference: {fileID: 0}
    - target: {fileID: 3251833912057786763, guid: d6f975b78195e9b4e8afcb9c9de98b50, type: 3}
      propertyPath: _hintsByID.Array.data[1].text
      value: Find out what happened to the people in the camp.
      objectReference: {fileID: 0}
    - target: {fileID: 3251833912057786763, guid: d6f975b78195e9b4e8afcb9c9de98b50, type: 3}
      propertyPath: _hintsByID.Array.data[2].text
      value: Find the doctor and ask for help.
      objectReference: {fileID: 0}
    - target: {fileID: 3251833912057786763, guid: d6f975b78195e9b4e8afcb9c9de98b50, type: 3}
      propertyPath: _hintsByID.Array.data[3].text
      value: Find the generator key in the shed.
      objectReference: {fileID: 0}
    - target: {fileID: 3251833912057786763, guid: d6f975b78195e9b4e8afcb9c9de98b50, type: 3}
      propertyPath: _hintsByID.Array.data[4].text
      value: Find the generator.
      objectReference: {fileID: 0}
    - target: {fileID: 3251833912057786763, guid: d6f975b78195e9b4e8afcb9c9de98b50, type: 3}
      propertyPath: _hintsByID.Array.data[5].text
      value: Fix the electrical system to open the main door.
      objectReference: {fileID: 0}
    - target: {fileID: 3251833912057786763, guid: d6f975b78195e9b4e8afcb9c9de98b50, type: 3}
      propertyPath: _notesByID.Array.data[2].text
      value: "Situation Report - Preliminary Summary\n\nContamination began at water
        source. Rapid infection spread through camp. Symptoms: aggression, disorientation.
        No known cure. Entire zone under lockdown.\n\nDo not touch the water without
        PROTECTION.\n\n\u2014 Dr. Elias Kessler\nAdvanced Response Unit, M.E.D.C.O.R.E.\nDate:
        08/13 \u2014 11:42 PM"
